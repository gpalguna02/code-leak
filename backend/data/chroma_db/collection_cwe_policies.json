  "CWE-89": {
    "id": "CWE-89",
    "document": "CWE-89 SQL Injection: Untrusted user input is directly concatenated, formatted, or interpolated into a database query string before execution. Attackers can bypass authentication, view private records, or drop entire database tables. Remediation: Always use parameterized queries (prepared statements) or ORM parameter binding. Never construct SQL via f-strings or '+' string concatenation.",
    "metadata": {
      "title": "CWE-89: SQL Injection",
      "cwe_id": "CWE-89",
      "category": "CWE",
      "severity": "CRITICAL",
      "remediation_checklist": "[\"Refactor raw SQL strings to use parameterized query placeholders (%s or ?).\", \"Ensure user inputs are never formatted directly into SQL query templates.\", \"Use ORM query builders (e.g. SQLAlchemy, Prisma) with native parameter sanitization.\", \"Conduct automated SQL injection vulnerability test before merge.\"]"
    },
