  "CWE-327": {
    "id": "CWE-327",
    "document": "CWE-327 Broken or Risky Cryptographic Algorithm: The application utilizes deprecated or weak algorithms such as MD5, SHA-1, DES, RC4, or ECB block cipher mode. These algorithms possess known cryptographic weaknesses, collision attacks, and can be broken with minimal compute. Remediation: Upgrade hashing algorithms to SHA-256 / SHA-3 for digest integrity, Argon2id/bcrypt for password hashing, and AES-GCM (256-bit) with authenticated encryption for symmetric data.",
    "metadata": {
      "title": "CWE-327: Use of a Broken or Risky Cryptographic Algorithm",
      "cwe_id": "CWE-327",
      "category": "CWE",
      "severity": "HIGH",
      "remediation_checklist": "[\"Replace hashlib.md5 and hashlib.sha1 with hashlib.sha256 or hashlib.sha3_256.\", \"Use Argon2id or bcrypt with high work factor for user password storage.\", \"Replace ECB cipher mode with authenticated Galois/Counter Mode (AES-GCM).\", \"Audit all cryptographic primitives against modern NIST SP 800-131A standards.\"]"
    },
