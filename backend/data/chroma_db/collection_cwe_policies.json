  "CWE-798": {
    "id": "CWE-798",
    "document": "CWE-798 Use of Hard-coded Credentials: The software contains hard-coded credentials, such as an API key, private key, token, or database password. Exposed keys in source control can be extracted by attackers and used to compromise infrastructure. Remediation: Invalidate and rotate the exposed credential immediately. Store secrets in environment variables (.env excluded via .gitignore) or local/cloud secrets managers (AWS Secrets Manager, HashiCorp Vault). Use git-filter-repo to purge keys from Git history.",
    "metadata": {
      "title": "CWE-798: Use of Hard-coded Credentials",
      "cwe_id": "CWE-798",
      "category": "CWE",
      "severity": "CRITICAL",
      "remediation_checklist": "[\"Immediately revoke/rotate the compromised secret in provider dashboard (AWS, GitHub, Stripe).\", \"Migrate credential to local environment variables (.env) or Vault secrets manager.\", \"Verify .gitignore includes .env, *.pem, and local credentials files.\", \"Run git-filter-repo or git-rebase to purge secret commit from git history.\"]"
    },
