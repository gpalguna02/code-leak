  "CWE-312": {
    "id": "CWE-312",
    "document": "CWE-312 Cleartext Storage / Transmission: Confidential data such as passwords, access tokens, API keys, or PII are stored or transmitted in plaintext (e.g., printed in application logs, transmitted over unencrypted HTTP, or saved in unencrypted config files). Remediation: Implement automatic log masking for authentication tokens and credentials. Enforce TLS 1.3 for all transport and encrypt sensitive database columns at rest.",
    "metadata": {
      "title": "CWE-312: Cleartext Storage of Sensitive Information",
      "cwe_id": "CWE-312",
      "category": "CWE",
      "severity": "HIGH",
      "remediation_checklist": "[\"Add filter to logging pipeline to mask authorization tokens and passwords before printing.\", \"Ensure sensitive URLs use HTTPS with strict transport security (HSTS).\", \"Store sensitive configurations encrypted at rest using local secret stores.\", \"Conduct review of all print/console.log statements in production code.\"]"
    },
