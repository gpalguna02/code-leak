  "POL-SEC-01": {
    "id": "POL-SEC-01",
    "document": "Internal DevSecOps Policy POL-SEC-01: No plaintext credentials, private keys, cloud tokens, or API secrets are permitted in any Git branch. Pre-commit hooks must block commits containing high-entropy keys. CI/CD pipelines must immediately fail builds upon detection of credentials.",
    "metadata": {
      "title": "POL-SEC-01: Zero Credential Commit Policy",
      "cwe_id": "CWE-798",
      "category": "COMPANY_POLICY",
      "severity": "CRITICAL",
      "remediation_checklist": "[\"Ensure pre-commit scanner is installed and active in local repo.\", \"Adopt central secret manager for development and production environments.\"]"
    },
