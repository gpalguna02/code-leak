  "CWE-22": {
    "id": "CWE-22",
    "document": "CWE-22 Path Traversal: The application constructs file paths using external input without verifying that the path resolves within the intended directory. Attackers can provide '../' sequences to read or overwrite sensitive system files like /etc/passwd or application source files. Remediation: Normalize path using os.path.abspath and verify with os.path.commonpath that the resulting canonical path starts with the trusted root folder.",
    "metadata": {
      "title": "CWE-22: Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')",
      "cwe_id": "CWE-22",
      "category": "CWE",
      "severity": "CRITICAL",
      "remediation_checklist": "[\"Resolve canonical path using os.path.realpath / os.path.abspath.\", \"Verify that target file path starts strictly with the designated storage root folder.\", \"Reject user-supplied path strings containing '..' or directory separators.\", \"Consider mapping user input to an internal UUID or whitelist instead of raw filenames.\"]"
    },
